# Copy to .env and adjust. The .env file is git-ignored.
# NOTE: the keys below are PUBLIC Besu test accounts. They are safe here because
# the network is a private, isolated demo chain with zero-value gas. Never reuse
# them on any real network.

# Signed-cookie secret for web sessions (change this).
SESSION_SECRET=dev-change-me
CLASS_TIMEZONE=Europe/Paris

# JSON-RPC endpoint of the blockchain gateway node (validator1, internal only).
RPC_URL=http://validator1:8545

# Teacher account (the only account that writes to the ledger).
TEACHER_ADDRESS=0xfe3b557e8fb62b89f4916b721be55ceb828dbd73
TEACHER_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# Enrolled demo students (read-only; no private key needed).
STUDENT1_ADDRESS=0x627306090abaB3A6e1400e9345bC60c78a8BEf57
STUDENT2_ADDRESS=0xf17f52151EbEF6C7334FAD080c5704D77216b732

# Demo login passwords (web accounts only, not blockchain keys).
TEACHER_PASSWORD=teacher
STUDENT1_PASSWORD=student1
STUDENT2_PASSWORD=student2
