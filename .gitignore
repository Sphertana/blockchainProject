.DS_Store
._*
Thumbs.db

# Local editor settings, logs and temporary files
.vscode/
.idea/
*.log
*.tmp
*.swp
*.swo
*~

# Local project skill: guides local work, intentionally not part of the public repo
.github/skills/

# Markdown sources stay local; only the root README is versioned
*.[mM][dD]
!/README.md

# Generated PDFs stay local; only the final technical report is versioned
*.[pP][dD][fF]
!/docs/report/rapport-technique.pdf

# Local Azure deployment state
scripts/azure/.vm_ip
scripts/azure/.vm_host
scripts/azure/.demo_credentials
